{
  "name": "Neuron Diagram Maker",
  "short_name": "Neurons",
  "description": "Draw neuron diagrams and export them as TikZ (LaTeX) code or images.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#151a21",
  "theme_color": "#151a21",
  "icons": [
    {
      "src": "icon-180.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
